# Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
PUBLIC_SITE_URL="https://palm-and-grace.vercel.app"

# PostgreSQL Database (Render / Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@hostname:5432/palm_and_grace?sslmode=require"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"

# Default Admin Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@palmgrace.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeOnFirstLogin2026!"
ADMIN_DEFAULT_NAME="Palm & Grace Administrator"

# Controlled CORS Origins (Comma-separated for local dev + production Vercel deployment)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173,https://palm-grace-web.vercel.app,https://palmandgrace.org,https://www.palmandgrace.org"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Zoho SMTP: set these only in the Render backend environment.
# Do not commit SMTP_PASSWORD or expose it to the frontend.
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
MAIL_TO=""

# Legacy Brevo integration retained until Zoho is verified in production.
BREVO_API_KEY="xkeysib-xxxxxxxxx"
BREVO_SENDER_EMAIL="enquiries@your-verified-domain.example"
BREVO_SENDER_NAME="Palm & Grace Memorials"
EMAIL_LOGO_URL="https://palm-grace-web.vercel.app/email/palm-grace-logo.png"
FAMILY_ENQUIRY_TO_EMAIL="family-enquiries@example.com"
CARE_PARTNER_ENQUIRY_TO_EMAIL="partners@example.com"

# Public enquiry delivery (configured in Render; never expose these to Vercel/client code)
RESEND_API_KEY="re_xxxxxxxxx"
ENQUIRY_FROM_EMAIL="Palm & Grace <enquiries@your-verified-domain.example>"
FAMILY_ENQUIRY_TO_EMAIL="family-enquiries@example.com"
CARE_PARTNER_ENQUIRY_TO_EMAIL="partners@example.com"
