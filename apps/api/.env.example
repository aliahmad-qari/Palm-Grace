# Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
PUBLIC_SITE_URL="https://palm-grace-web.vercel.app"

# PostgreSQL Database (Render / Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@hostname:5432/palm_and_grace?sslmode=require"

# JWT Authentication (HTTP-Only Cookies)
JWT_SECRET="replace-with-a-secure-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"

# Default Admin Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@palmgrace.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeOnFirstLogin2026!"
ADMIN_DEFAULT_NAME="Palm & Grace Administrator"
# One-time recovery: set true, deploy once to upsert the configured admin and
# bcrypt password hash, then set back to false and redeploy.
ADMIN_SYNC_ON_START="false"

# Controlled CORS Origins (Comma-separated for local dev + production Vercel deployment)
# Local dev: http://localhost:3000 (API), http://localhost:3001 (Next.js frontend)
# Production: https://palm-grace-web.vercel.app
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173,https://palm-grace-web.vercel.app"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Feature Flags
ENABLE_PUBLIC_DIRECTORY="true"

# Zoho SMTP: configure these ONLY as Render backend environment variables.
# Keep SMTP_PASSWORD secret; never put its value in this file or Vercel.
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
MAIL_TO=""

# Legacy Brevo/Resend settings retained until Zoho is verified in production.
# Verify the sender/domain in Brevo and configure these in Render.
BREVO_API_KEY="xkeysib-xxxxxxxxx"
BREVO_SENDER_EMAIL="enquiries@your-verified-domain.example"
BREVO_SENDER_NAME="Palm & Grace Memorials"
# Must be an HTTPS URL accessible by email clients. Defaults to:
# https://palm-grace-web.vercel.app/email/palm-grace-logo.png
EMAIL_LOGO_URL="https://your-public-domain.example/email/palm-grace-logo.png"

# Optional legacy fallback used only when BREVO_API_KEY is not configured.
RESEND_API_KEY=""
ENQUIRY_FROM_EMAIL="Palm & Grace <enquiries@your-verified-domain.example>"
FAMILY_ENQUIRY_TO_EMAIL="family-enquiries@example.com"
CARE_PARTNER_ENQUIRY_TO_EMAIL="partners@example.com"
