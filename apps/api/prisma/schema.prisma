datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TemplateType {
  MALE
  FEMALE
  CHILD
}

enum PublicationStatus {
  DRAFT
  PRIVATE_PREVIEW
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum TributeStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Memorial {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  fullName              String
  preferredDisplayName  String?
  birthDate             DateTime?
  showBirthDate         Boolean           @default(true)
  deathDate             DateTime?
  showDeathDate         Boolean           @default(true)
  dateOfBirth           DateTime?
  dateOfPassing         DateTime?
  biography             String            @db.Text
  memorialLine          String?           @db.Text
  lifeStory             String?           @db.Text
  mainPhotograph        String            @db.Text
  heroBackgroundUrl     String?           @db.Text
  portraitPositionX     Int               @default(50)
  portraitPositionY     Int               @default(50)
  serviceTitle          String?
  serviceDate           DateTime?
  serviceTime           String?
  serviceVenue          String?
  serviceAddress        String?           @db.Text
  viewingWakeInformation String?           @db.Text
  serviceInformation    String?           @db.Text
  familyAcknowledgement String?           @db.Text
  livestreamUrl         String?
  recordingUrl          String?
  closingWords          String?           @db.Text
  templateType          TemplateType      @default(MALE)
  publicationStatus     PublicationStatus @default(DRAFT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  media                 MemorialMedia[]
  tributes              Tribute[]

  @@index([slug])
  @@index([publicationStatus])
  @@index([createdAt])
  @@map("memorials")
}

model MemorialMedia {
  id                 String   @id @default(uuid())
  memorialId         String
  memorial           Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String?
  url                String   @db.Text
  mediaType          MediaType @default(PHOTO)
  caption            String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([memorialId])
  @@index([sortOrder])
  @@map("memorial_media")
}

model Tribute {
  id          String        @id @default(uuid())
  memorialId  String
  memorial    Memorial      @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  visitorName String
  relationship String?
  message     String        @db.Text
  contributorEmail String?
  status      TributeStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([memorialId, status])
  @@index([createdAt])
  @@map("tributes")
}
