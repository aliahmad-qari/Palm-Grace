# React + Vite Frontend Environment Variables

# During development: API calls to /api/* are proxied to http://localhost:3000 via vite.config.ts
# During production on Vercel: Set VITE_API_URL to your Render backend URL
VITE_API_URL=""

# Public contact address displayed on the Our Story page. Set the confirmed
# Palm & Grace inbox in Vercel; leave blank until the client approves it.
VITE_PUBLIC_CONTACT_EMAIL=""

# Example for production:
# VITE_API_URL="https://your-render-api.onrender.com"

# Cloudinary (Public key for image optimization)
VITE_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

